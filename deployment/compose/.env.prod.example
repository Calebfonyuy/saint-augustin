# =============================================================================
# SaintAugustin — production docker-compose environment
#
#   cp .env.prod.example .env.prod   &&   edit every REPLACE_ME below
#   docker compose -f docker-compose.prod.yml --env-file .env.prod up -d
#
# Every value marked REQUIRED is enforced by the compose file (`${VAR:?...}`)
# — the stack refuses to start if it is unset. Do NOT commit the populated
# .env.prod file.
# =============================================================================

# ── Release ─────────────────────────────────────────────────────────────────
# REQUIRED. The image tag to pull for staug-api / staug-projection /
# staug-frontend. Build + push these first (see README.md / docs/SETUP.md).
APP_VERSION=0.2

# ── Public URLs (must match how the browser reaches each service) ───────────
APP_NAME=SaintAugustin
APP_URL=http://api.example.com                 # REQUIRED — public API base
APP_FRONTEND_URL=http://app.example.com        # REQUIRED — public SPA base
APP_PROJECTION_URL=http://projection.example.com

# ── Laravel secrets ─────────────────────────────────────────────────────────
# REQUIRED. Generate APP_KEY with: docker run --rm calebfonyuy/staug-api:$APP_VERSION \
#   php artisan key:generate --show
APP_KEY=base64:REPLACE_ME
JWT_SECRET=REPLACE_ME_min_32_chars

# ── STAUG data-interchange ──────────────────────────────────────────────────
# REQUIRED. HMAC key for signed archive export/import (openssl rand -base64 32).
# DR-critical: archives only validate on instances holding the same key.
STAUG_SIGNING_KEY=REPLACE_ME_min_32_chars

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
POSTGRES_USER=staug                            # REQUIRED
POSTGRES_PASSWORD=REPLACE_ME                    # REQUIRED
DB_AUTH_NAME=saintaugustin_db

# ── Object storage (MinIO) ──────────────────────────────────────────────────
MINIO_ROOT_USER=minioadmin                     # REQUIRED
MINIO_ROOT_PASSWORD=REPLACE_ME                  # REQUIRED
# REQUIRED — must be reachable BY THE BROWSER (presigned song-sheet/export URLs).
MINIO_ENDPOINT=http://minio.example.com:9000
MINIO_BUCKET=saintaugustin
MINIO_REGION=us-east-1
SONG_SHEET_URL_TTL=15
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# ── Bible module (HelloAO Free Use Bible API — public domain, no key) ───────
BIBLE_API_BASE=https://bible.helloao.org/api

# ── Mail ─────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com                      # REQUIRED
MAIL_PORT=587
MAIL_USERNAME=REPLACE_ME
MAIL_PASSWORD=REPLACE_ME
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=noreply@saintaugustin.example.com
MAIL_FROM_NAME=SaintAugustin

# ── Projection service ───────────────────────────────────────────────────────
# REQUIRED — internal URL the projection service uses to validate tokens
# against the API (the compose service name + port, e.g. http://staug-api:80).
AUTH_SERVICE_URL=http://staug-api:80
SESSION_TTL_SECONDS=14400

# ── Frontend runtime config (injected into config.js at container start) ────
VITE_API_BASE_URL=http://api.example.com/api           # REQUIRED
VITE_WS_URL=ws://projection.example.com/ws             # REQUIRED
VITE_PROJECTION_BASE_URL=http://projection.example.com # REQUIRED

# ── Published host ports (host:container) ───────────────────────────────────
FRONTEND_PORT=8080
AUTH_SERVICE_PORT=8000
PROJECTION_SERVICE_PORT=3000
