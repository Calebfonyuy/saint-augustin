# =============================================================================
# SaintAugustin – Environment Configuration
# Copy to .env and adjust values for your environment
# =============================================================================

APP_VERSION=0.2

API_BASE_URL=http://localhost:8001
FRONTEND_URL=http://localhost:5173
PROJECTION_URL=http://localhost:3000
PROJECTION_WS_URL=ws://localhost:3000/ws

# -- Service Ports
API_PORT=8001
FRONTEND_PORT=5173
MINIO_CONSOLE_PORT=9001
PROJECTION_SERVICE_PORT=3000
PROJECTION_WS_PORT=3000

# --- Auth Service ---
APP_ENV=production
APP_DEBUG=false
APP_LOCALE=en
APP_KEY=changeme_app_key_at_least_32_chars
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
BIBLE_API_BASE=https://bible.helloao.org/api
# --- STAUG data-interchange (HMAC signing key for exported archives) ---
# Generate with: openssl rand -base64 32
# DR-critical: an archive can only be verified by an instance holding the
# same key, so keep this backed up and consistent across instances that
# need to validate each other's exports.
STAUG_SIGNING_KEY=28bGjVuphDNfn4r0I4UwAPJJkwdn2nc02w9sjOkiYFU=

# --- Mail (invitations, password resets, full-export links) ---
MAIL_MAILER=smtp
MAIL_HOST=mail.suuynyuy.com
MAIL_PORT=465
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=
MAIL_FROM_NAME=SaintAugustin

# --- AWS S3 service (optional, for production use)
FILESYSTEM_DISK=minio
AWS_ENDPOINT=http://minio:9000
AWS_ACCESS_KEY_ID=<your_aws_access_key_id>
AWS_SECRET_ACCESS_KEY=<your_aws_secret_access_key>
AWS_DEFAULT_REGION=us-west-3
AWS_BUCKET=staug-data-bkt
AWS_USE_PATH_STYLE_ENDPOINT=false


# --- PostgreSQL ---
POSTGRES_DB_NAME=saintaugustin_db
POSTGRES_USER=saintaugustin
POSTGRES_PASSWORD=saintaugustin_db_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
