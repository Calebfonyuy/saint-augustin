# =============================================================================
# SaintAugustin – Environment Configuration
# Copy to .env and adjust values for your environment
# =============================================================================

# --- App Version to Attach to Images---
APP_VERSION=0.2

BASE_SERVER_IP=localhost

API_PORT=8001

# --- PostgreSQL ---
POSTGRES_USER=saintaugustin
POSTGRES_PASSWORD=saintaugustin_db_password
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Per-service databases (created by init script)
DB_AUTH_NAME=saintaugustin_db

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
# Cache, queue, and sessions all run on Redis. QUEUE_CONNECTION=redis is
# required for the queue-worker to pick up dispatched jobs (e.g. the STAUG
# full-DB export); with `sync` they would run in-request instead.
CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_changeme
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=saintaugustin
MINIO_CONSOLE_PORT=9001

# --- Auth Service ---
AUTH_SERVICE_PORT=8001
JWT_SECRET=changeme_jwt_secret_at_least_32_chars
JWT_TTL=1440

# Google OAuth (leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8001/auth/google/callback

# --- Projection Service (NestJS) ---
PROJECTION_SERVICE_PORT=3000
PROJECTION_WS_PORT=3000

# --- Frontend ---
APP_FRONTEND_URL=http://localhost:5173
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8001
VITE_WS_URL=ws://localhost:8001/ws
VITE_PROJECTION_BASE_URL=http://localhost:3000

# --- Nginx Gateway ---
GATEWAY_HTTP_PORT=8080
GATEWAY_HTTPS_PORT=8443

# --- App ---
APP_ENV=local
APP_DEBUG=true
APP_LOCALE=en
APP_KEY=changeme_app_key_at_least_32_chars

# --- STAUG data-interchange (HMAC signing key for exported archives) ---
# Generate with: openssl rand -base64 32
# DR-critical: an archive can only be verified by an instance holding the
# same key, so keep this backed up and consistent across instances that
# need to validate each other's exports.
STAUG_SIGNING_KEY=changeme_staug_signing_key_at_least_32_chars

# Bible module — HelloAO Free Use Bible API base URL (public domain, no key).
BIBLE_API_BASE=https://bible.helloao.org/api

# --- Mail (invitations, password resets, full-export links) ---
# Non-dev environments need a real SMTP transport. The defaults below point
# at a sandbox; override host/credentials per environment.
MAIL_MAILER=smtp
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_SCHEME=tls
MAIL_FROM_ADDRESS=noreply@saintaugustin.local
MAIL_FROM_NAME=SaintAugustin
