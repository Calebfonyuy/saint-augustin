# =============================================================================
# SaintAugustin – Environment Configuration
# Copy to .env and adjust values for your environment
# =============================================================================

# --- PostgreSQL ---
POSTGRES_USER=saintaugustin
POSTGRES_PASSWORD=changeme_dev_only
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# Per-service databases (created by init script)
DB_AUTH_NAME=sa_auth
DB_SONG_NAME=sa_songs
DB_PLAYLIST_NAME=sa_playlists

# --- Redis ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# --- MinIO (S3-compatible object storage) ---
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_changeme
MINIO_ENDPOINT=http://minio:9000
MINIO_BUCKET=saintaugustin
MINIO_CONSOLE_PORT=9001

# --- Auth Service ---
AUTH_SERVICE_PORT=8001
JWT_SECRET=changeme_jwt_secret_at_least_32_chars
JWT_TTL=1440

# Google OAuth (leave empty to disable)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# --- Song Service ---
SONG_SERVICE_PORT=8002

# --- Playlist Service ---
PLAYLIST_SERVICE_PORT=8003

# --- File Service ---
FILE_SERVICE_PORT=8004

# --- Import Service ---
IMPORT_SERVICE_PORT=8005

# --- Projection Service (NestJS) ---
PROJECTION_SERVICE_PORT=3000
PROJECTION_WS_PORT=3000

# --- Frontend ---
FRONTEND_PORT=5173
VITE_API_BASE_URL=http://localhost:8080/api
VITE_WS_URL=ws://localhost:8080/ws

# --- Nginx Gateway ---
GATEWAY_HTTP_PORT=8080
GATEWAY_HTTPS_PORT=8443

# --- App ---
APP_ENV=local
APP_DEBUG=true
APP_LOCALE=en
