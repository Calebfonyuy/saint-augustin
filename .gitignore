# =============================================================================
# SaintAugustin Monorepo .gitignore
# =============================================================================

# --- OS ---
.DS_Store
Thumbs.db
*.swp
*.swo
*~

# --- IDEs ---
.idea/
.vscode/
*.sublime-project
*.sublime-workspace

# --- Laravel (PHP) ---
/services/*/vendor/
/services/*/.env
/services/*/storage/logs/*
/services/*/storage/framework/cache/*
/services/*/storage/framework/sessions/*
/services/*/storage/framework/views/*
/services/*/bootstrap/cache/*
/services/*/.phpunit.result.cache
/services/*/phpunit.xml

# --- Node.js (NestJS + Vue) ---
node_modules/
dist/
.nuxt/
.output/
*.tsbuildinfo
.eslintcache

# --- Frontend ---
/frontend/node_modules/
/frontend/dist/

# --- NestJS Projection ---
/services/projection/node_modules/
/services/projection/dist/

# --- Docker ---
docker/postgres/data/
docker/minio/data/
docker/redis/data/

# --- Environment files ---
.env
.env.local
.env.*.local

# --- Logs ---
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Coverage ---
coverage/
.nyc_output/
