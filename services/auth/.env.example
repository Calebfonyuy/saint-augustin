APP_NAME=SaintAugustin
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8001

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=saintaugustin_db
DB_USERNAME=saintaugustin
DB_PASSWORD=changeme_dev_only

CACHE_DRIVER=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis

REDIS_HOST=localhost
REDIS_PORT=6379

JWT_SECRET=changeme_jwt_secret_at_least_32_chars

# STAUG data-interchange (HMAC signing key for exported archives).
# Generate with: openssl rand -base64 32
# DR-critical: must match across instances that validate each other's exports.
STAUG_SIGNING_KEY=changeme_staug_signing_key_at_least_32_chars

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/auth/google/callback

# MinIO / Object Storage (Phase 2 — File Service / song sheets)
FILESYSTEM_DISK=minio
MINIO_ENDPOINT=http://minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin_changeme
MINIO_BUCKET=saintaugustin
MINIO_REGION=us-east-1
# How long presigned download URLs stay valid (minutes).
SONG_SHEET_URL_TTL=15

APP_FRONTEND_URL=http://localhost:5173

# Upload size caps (megabytes). The Laravel-side validators read these.
# IMPORTANT: PHP itself has a hard ceiling configured in
# docker/php/uploads.ini — these env values must NOT exceed it. Bumping
# one without the other will produce confusing 413/422 errors. See
# docker/php/uploads.ini for the procedure.
UPLOAD_IMPORT_MAX_MB=100
UPLOAD_SHEET_MAX_MB=10
